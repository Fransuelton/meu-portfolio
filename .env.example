# Cloudflare Web Analytics beacon token
# Get it: Cloudflare Dashboard → Web Analytics → Sites → Manage site → "Get JavaScript Snippet"
# Leave empty in local dev — analytics only loads when this var is set (build-time injection)
PUBLIC_CF_ANALYTICS_TOKEN=

# ─── Contact form (server-side only) ────────────────────────────────────────
# Consumed by src/pages/api/contact.ts via the Cloudflare runtime env.
#
# Local dev: put these in `.dev.vars` (not .env — Wrangler reads .dev.vars).
# Production: they are Worker secrets, NOT build vars. Set them with:
#   bunx wrangler secret put RESEND_API_KEY
#   bunx wrangler secret put EMAIL_FROM
#   bunx wrangler secret put EMAIL_TO
# Without RESEND_API_KEY the endpoint answers 503 and the form is dead.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Portfolio <noreply@fransuelton.dev>
EMAIL_TO=contato@fransuelton.dev